
import React, { useState } from 'react';
import { analyzeText } from './geminiService';

const TextAssistant: React.FC = () => {
  const [input, setInput] = useState('');
  const [output, setOutput] = useState('');
  const [loading, setLoading] = useState(false);

  const handleRun = async () => {
    setLoading(true);
    try {
      const res = await analyzeText(input);
      setOutput(res || '');
    } catch (err) { alert("Error."); }
    finally { setLoading(false); }
  };

  return (
    <div className="bg-white rounded-3xl p-6 shadow-sm border">
      <h2 className="text-2xl font-bold mb-6">AI Text Assistant</h2>
      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
        <textarea value={input} onChange={(e) => setInput(e.target.value)} placeholder="Escribe aquí o pega un texto..." className="w-full h-64 p-4 bg-slate-50 border rounded-2xl resize-none" />
        <div className="bg-slate-900 p-6 rounded-2xl text-slate-100 h-64 overflow-y-auto font-light leading-relaxed">
          {loading ? 'Pensando...' : output || 'El resultado aparecerá aquí...'}
        </div>
      </div>
      <button onClick={handleRun} disabled={loading || !input} className="w-full py-4 bg-indigo-600 text-white rounded-xl font-bold mt-4 disabled:opacity-50">Analizar Texto</button>
    </div>
  );
};

export default TextAssistant;
